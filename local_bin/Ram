#!/usr/bin/env bash

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

echo -e "${CYAN}${BOLD}=== Очистка оперативной памяти (RAM) ===${NC}"
echo ""
echo -e "${BLUE}${BOLD}Память ДО очистки:${NC}"
free -h | awk 'NR==1{print "             "$0} NR>1{print $0}'

echo ""
echo -e "${YELLOW}Сбрасываем кэш и буферы памяти (sync && drop_caches)...${NC}"

sync

if [ "$EUID" -eq 0 ]; then
    echo 3 > /proc/sys/drop_caches
    sysctl -w vm.compact_memory=1 >/dev/null 2>&1
    swapoff -a 2>/dev/null && swapon -a 2>/dev/null
else
    sudo sh -c "echo 3 > /proc/sys/drop_caches; sysctl -w vm.compact_memory=1 >/dev/null 2>&1; swapoff -a 2>/dev/null && swapon -a 2>/dev/null"
fi

echo ""
echo -e "${GREEN}${BOLD}Память ПОСЛЕ очистки:${NC}"
free -h | awk 'NR==1{print "             "$0} NR>1{print $0}'

echo ""
echo -e "${GREEN}${BOLD}✓ Очистка RAM успешно завершена!${NC}"
